{
  "name": "@techseeding/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "release:txd": "pnpm -F @techseeding/deploy release:txd",
    "release:kpai": "git push && pnpm -F @techseeding/kidplayai build:docker && KPAI_SCALE_LEVEL=${KPAI_SCALE_LEVEL:-1} pnpm -F @techseeding/deploy release:kpai",
    "release:kpai4": "KPAI_SCALE_LEVEL=4 pnpm release:kpai",
    "release:kpai8": "KPAI_SCALE_LEVEL=8 pnpm release:kpai",
    "release:kpai:public-db": "KPAI_DB_PUBLICLY_ACCESSIBLE=true pnpm release:kpai",
    "release:ytai": "git push && pnpm -F @techseeding/yoututorai build:docker && pnpm -F @techseeding/deploy release:ytai",
    "release:all": "pnpm release:txd && pnpm release:kpai && pnpm release:ytai",
    "db:connect:prod": "pnpm -F @techseeding/deploy db:connect",
    "db:jdbc:prod": "pnpm -F @techseeding/deploy db:jdbc",
    "diff:kpai": "pnpm -F @techseeding/deploy diff:kpai",
    "diff:ytai": "pnpm -F @techseeding/deploy diff:ytai",
    "synth:kpai": "pnpm -F @techseeding/deploy synth:kpai",
    "synth:ytai": "pnpm -F @techseeding/deploy synth:ytai",
    "azure:bootstrap": "pnpm -F @techseeding/deploy-azure bootstrap",
    "azure:deploy:infra": "pnpm -F @techseeding/deploy-azure deploy:infra",
    "azure:deploy:apps": "pnpm -F @techseeding/deploy-azure deploy:apps",
    "azure:seed-secrets": "pnpm -F @techseeding/deploy-azure seed-secrets",
    "azure:print-ns": "pnpm -F @techseeding/deploy-azure print-ns",
    "release:azure:kpai": "pnpm -F @techseeding/deploy-azure release:kpai",
    "release:azure:ytai": "pnpm -F @techseeding/deploy-azure release:ytai",
    "release:azure:txd": "pnpm -F @techseeding/deploy-azure release:txd",
    "release:azure:all": "pnpm release:azure:txd && pnpm release:azure:kpai && pnpm release:azure:ytai"
  }
}
