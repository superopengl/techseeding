{
  "name": "@techseeding/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "bootstrap": "pnpm -F @techseeding/deploy bootstrap",
    "deploy:infra": "pnpm -F @techseeding/deploy deploy:infra",
    "deploy:apps": "pnpm -F @techseeding/deploy deploy:apps",
    "seed-secrets": "pnpm -F @techseeding/deploy seed-secrets",
    "print-ns": "pnpm -F @techseeding/deploy print-ns",
    "release:kpai": "pnpm -F @techseeding/deploy release:kpai",
    "release:ytai": "pnpm -F @techseeding/deploy release:ytai",
    "release:txd": "pnpm -F @techseeding/deploy release:txd",
    "release:all": "pnpm release:txd && pnpm release:kpai && pnpm release:ytai"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
