{
  "name": "@techseeding/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "synth:kpai": "CDK_APP=kpai cdk synth",
    "synth:ytai": "CDK_APP=ytai cdk synth",
    "diff:kpai": "CDK_APP=kpai cdk diff",
    "diff:ytai": "CDK_APP=ytai cdk diff",
    "deploy:kpai": "CDK_APP=kpai cdk deploy --require-approval never",
    "deploy:ytai": "CDK_APP=ytai cdk deploy --require-approval never",
    "destroy:kpai": "CDK_APP=kpai cdk destroy",
    "destroy:ytai": "CDK_APP=ytai cdk destroy",
    "bootstrap": "CDK_APP=kpai cdk bootstrap",
    "release:kpai": "./scripts/release-kpai.sh",
    "release:ytai": "./scripts/release-ytai.sh",
    "release:txd": "./scripts/release-txd.sh",
    "build-and-push:kpai": "APP=kpai ./scripts/build-and-push.sh",
    "build-and-push:ytai": "APP=ytai ./scripts/build-and-push.sh",
    "migrate:kpai": "APP=kpai ./scripts/run-migration.sh",
    "migrate:ytai": "APP=ytai ./scripts/run-migration.sh",
    "ecr:lifecycle:kpai": "APP_REPO_NAME=kpai ./scripts/ecr-lifecycle.sh",
    "ecr:lifecycle:ytai": "APP_REPO_NAME=ytai ./scripts/ecr-lifecycle.sh",
    "db:connect": "./scripts/db-connect.sh",
    "db:jdbc": "./scripts/db-jdbc.sh",
    "bootstrap:ytai-db": "./scripts/bootstrap-ytai-db.sh",
    "deploy:kpai-force": "./scripts/deploy-kpai.sh"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.170.0"
  }
}
