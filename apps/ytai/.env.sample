# YouTutorAI environment variables.
# Copy to `.env` for local dev or `.env.production` for prod. All vars prefixed with YTAI_.

YTAI_DATABASE_URL=postgres://localhost:5432/yoututorai
YTAI_API_PORT=9521
YTAI_PORTAL_PORT=9522

YTAI_JWT_SECRET=

# Google Sign-In (Google Identity Services). Create an OAuth 2.0 Client ID of
# type "Web application" in the Google Cloud Console, add http://localhost:9522
# (and your prod origin) to "Authorized JavaScript origins", and paste the
# Client ID below. Leave unset to disable Google SSO — /api/auth/google returns
# 503 and the homepage button greys out.
YTAI_GOOGLE_CLIENT_ID=141448668439-jj21t4ctgr5lgetk7mpkc6ggdthmmvp7.apps.googleusercontent.com

# Brain (chat) provider. OpenAI-compatible /v1/chat/completions endpoint.
# The chat model must be multimodal — it reads the worksheet directly in
# the user message. Defaults to OpenRouter; override the base URL to point
# at a local server (e.g. LM Studio + Gemma 4) for offline dev.
YTAI_OPENROUTER_API_KEY=
# OpenRouter model ids are <provider>/<model>. Example:
#   google/gemma-4-e4b, google/gemini-2.5-pro, openai/gpt-4o,
#   anthropic/claude-sonnet-4-6
YTAI_OPENROUTER_CHAT_MODEL=google/gemma-4-e4b
# Override the chat-completions base URL. Defaults to https://openrouter.ai/api/v1.
# To run locally against LM Studio + Gemma 4:
#   YTAI_OPENROUTER_BASE_URL=http://localhost:9529/v1
#   YTAI_OPENROUTER_API_KEY=lm-studio   (any non-empty value; LM Studio ignores)
YTAI_OPENROUTER_BASE_URL=

# Azure Blob Storage for session images and TTS audio. When unset, persistImage
# / persistAudio fall back to local disk under YTAI_IMAGE_DIR / YTAI_AUDIO_DIR.
# In prod (set by Bicep) this points at the deploy's storage account; for local
# dev, point at the same account and let YTAI_BLOB_PREFIX namespace your keys.
# Authentication uses DefaultAzureCredential (managed identity in prod, `az
# login` token locally) — no account keys live in this file.
YTAI_STORAGE_ACCOUNT_URL=
YTAI_BLOB_CONTAINER=ytai-images
# Key namespace inside the container. Defaults to "dev" so a misconfigured
# laptop can't write into prod's keyspace. Bicep sets this to the deployed
# stage ("prod") in production.
YTAI_BLOB_PREFIX=dev

# Azure Communication Services Email (sign-in OTP delivery). The connection
# string + sender address come from the ACS resource; the sender domain must
# be verified (DKIM/SPF/DMARC) in ACS before any email lands. Leave the
# connection string unset to skip ACS — the OTP is still stored in the DB and
# logged so an operator can read the code from server logs.
YTAI_ACS_CONNECTION_STRING=
YTAI_ACS_SENDER=

# TTS. Frontend POSTs sentences to /api/tutor/:sessionId/speak; the server
# proxies to an OpenAI-compatible /audio/speech endpoint. For local dev we
# run Kokoro-FastAPI via `pnpm start:local:tts`:
#   YTAI_TTS_BASE_URL=http://localhost:9530/v1
# Leave unset to disable voice — the /speak route returns 503 and the UI greys
# out the voice toggle.
YTAI_TTS_BASE_URL=
YTAI_TTS_API_KEY=
YTAI_TTS_MODEL=kokoro
# Kokoro voice ids: af_heart (warm female), af_bella, af_sky, am_adam, am_michael, …
YTAI_TTS_VOICE=af_heart
# Where to cache MP3 bytes on disk (mirrors YTAI_IMAGE_DIR).
YTAI_AUDIO_DIR=./data/audio
