# KidPlayAI Environment Variables
# Copy this file to .env for local development or .env.production for production.

KPAI_DATABASE_URL=postgres://localhost:5432/kidplayai
KPAI_API_PORT=9511
KPAI_PUBLIC_URL=http://localhost:9512
KPAI_JWT_SECRET=change-me-to-a-random-secret

# Admin sign-in (POST /api/auth/admin). On boot, if both vars are set, the
# server ensures a role=admin user with this username exists and that the
# password_hash matches. Leave unset in production once the hash is seeded
# directly in the DB.
KPAI_ADMIN_USERNAME=admin
KPAI_ADMIN_PASSWORD=change-me

# Sandbox LLM config (DeepSeek, via Vercel AI SDK)
KPAI_SANDBOX_DEEPSEEK_API_KEY=<your DeepSeek API Key>
# Optional: override the DeepSeek model id (defaults to "deepseek-chat")
# KPAI_SANDBOX_DEEPSEEK_MODEL=deepseek-chat

# Google Sign-In (OAuth 2.0 web client ID). Leave blank to disable SSO.
KPAI_GOOGLE_CLIENT_ID=

# AWS SES (sign-in OTP email delivery). Leave KPAI_SES_FROM_EMAIL blank to
# skip SES — the OTP is still written to the DB so admins can read it from
# the admin user list as a fallback.
KPAI_AWS_REGION=ap-southeast-2
KPAI_SES_FROM_EMAIL=